<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.justin.inkyoled"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />

    <!-- weather lookup only; everything else is bundled locally -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE is reused by the Device widget's JS bridge to report the
         active transport (Wi-Fi / Ethernet / none) and whether it validated. The bridge
         deliberately does not read SSID/BSSID/signal, which would require a location
         permission on Android 10+. No other permission is needed: battery comes from the
         sticky ACTION_BATTERY_CHANGED broadcast, storage from StatFs on our own data
         directory, memory from ActivityManager, uptime from SystemClock. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- so it can relaunch itself on boot once you enable that -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Inky OLED"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Relaunch after reboot / power cut.
             May be blocked by Android 10+ background-activity-start rules unless the app
             has SYSTEM_ALERT_WINDOW. See BootReceiver for how to grant it. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
